# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Python cache and compiled files
python/**/__pycache__/
python/**/*.pyc
python/**/*.pyo
python/**/*.pyd
python/**/*.so
python/**/*.egg-info/

# Python virtual environment (if created inside src-tauri)
.venv/
venv/
env/

# PyTauri build artifacts
*.egg-info/
build/
dist/
